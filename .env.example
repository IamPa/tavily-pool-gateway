# 复制为 .env 并填写（.env 已被 .gitignore 忽略，不会入库）

# 逗号分隔的 Tavily API key 列表，多个 key 自动进入 key 池参与轮询
# 示例: TAVILY_KEYS=tvly-xxxxxxxxxxxx,tvly-yyyyyyyyyyyy
TAVILY_KEYS=

# 网关监听端口
PORT=8000

# 网关鉴权 token（可选）。
# 留空 = 不鉴权，适合 Tailscale 内网自用；
# 配置后调用方需带 "Authorization: Bearer <token>"，网关校验通过后替换为上游 key
GATEWAY_TOKEN=

# /usage 配额校准周期（秒），默认 3600（每小时）。
# 注意 Tavily 的 /usage 接口限流为 10 次 / 10 分钟，请勿调太小
USAGE_SYNC_INTERVAL=3600
